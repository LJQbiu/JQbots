        </so101_old_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist/gripper/jaw>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "shoulder" (
