                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "jaw" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_flex" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "elbow_flex" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_lift" (
